# Neon PostgreSQL Production Configuration Template
# Use these environment variables when deploying to production with Neon
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://bookleaf.vercel.app

# Database (Neon PostgreSQL with SSL required)
# Format: postgres://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgres://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/bookleaf?sslmode=require
DB_SSL=true

# Authentication — JWT (Must be at least 32 characters in production)
JWT_SECRET=replace-with-a-cryptographically-random-32-char-string-in-prod
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true

# Initial Admin Seeding
ADMIN_EMAIL=admin@bookleaf.pub
ADMIN_PASSWORD=change-admin-password-in-production
ADMIN_NAME=BookLeaf Admin

