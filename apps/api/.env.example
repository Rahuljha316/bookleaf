# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgres://username:password@localhost:5432/bookleaf
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookleaf
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication — JWT
# REQUIRED: at least 32 characters; use a cryptographically random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-must-be-32-chars
# Token lifetime (ms / s / m / h / d accepted by jsonwebtoken)
JWT_EXPIRES_IN=7d
# Set to true when running behind HTTPS (Secure cookie flag)
COOKIE_SECURE=false

# Initial Admin Seeding
ADMIN_EMAIL=admin@bookleaf.pub
ADMIN_PASSWORD=admin123
ADMIN_NAME=BookLeaf Admin

# AI Provider Configuration (Pending decision)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
