{
  "name": "@bookleaf/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:dist": "node dist/scripts/migrate.js",
    "db:rollback": "tsx src/scripts/rollback.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:dist": "node dist/scripts/seed.js",
    "db:verify": "tsx src/scripts/verify-schema.ts",
    "auth:verify": "tsx src/scripts/verify-auth.ts",
    "ticket:verify": "tsx src/scripts/verify-tickets.ts"
  },
  "dependencies": {
    "@bookleaf/shared": "*",
    "@google/genai": "^3.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^4.86.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "umzug": "^3.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
