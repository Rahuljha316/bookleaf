# BookLeaf Monorepo — Environment Variables Template
# Copy this file to .env at the repository root: `cp .env.example .env`

# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgres://postgres:1234@localhost:5432/bookleaf_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookleaf_dev
DB_USER=postgres
DB_PASSWORD=1234
DB_SSL=false

# AI Provider Configuration
# Primary provider tried first; fallback providers tried in order on retryable failures.
# Supported values: openai, gemini
AI_PRIMARY_PROVIDER=openai
# Comma-separated fallback providers (leave empty to disable fallback)
AI_FALLBACK_PROVIDERS=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# OpenAI  (optional — only needed if using openai as a provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Authentication — JWT
# REQUIRED: at least 32 characters; use a cryptographically random string in production
JWT_SECRET=bookleaf-dev-jwt-secret-change-in-production-must-be-32-chars
# Token lifetime (ms / s / m / h / d accepted by jsonwebtoken)
JWT_EXPIRES_IN=7d
# Set to true when running behind HTTPS (Secure cookie flag)
COOKIE_SECURE=false

# Initial Admin Seeding
ADMIN_EMAIL=admin@bookleaf.pub
ADMIN_PASSWORD=admin123
ADMIN_NAME=BookLeaf Admin

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Production Deployment Reference (e.g., Neon PostgreSQL)
# -----------------------------------------------------------------------------
# When deploying to production with Neon PostgreSQL:
# NODE_ENV=production
# CORS_ORIGIN=https://bookleaf.vercel.app
# DATABASE_URL=postgres://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/bookleaf?sslmode=require
# DB_SSL=true
# COOKIE_SECURE=true
# JWT_SECRET=replace-with-a-cryptographically-random-32-char-string-in-prod
# ADMIN_PASSWORD=change-admin-password-in-production
