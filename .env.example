# Root Environment Example
# Copy to .env or configure in respective app directories

# Backend API Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgres://username:password@localhost:5432/bookleaf
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookleaf
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication (JWT)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Provider (Pending decision)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Frontend Configuration
VITE_API_URL=http://localhost:5000

