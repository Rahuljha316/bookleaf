# =============================================================================
# BookLeaf Monorepo — Environment Variables Template
# Copy this file to .env at the repository root: `cp .env.example .env`
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend API Configuration (Render Web Service / Local)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed CORS origins. In production, provide your Vercel URL.
# Supports comma-separated origins, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Database Configuration (Render PostgreSQL / Neon / Local PostgreSQL)
# -----------------------------------------------------------------------------
# When DATABASE_URL is set, it takes precedence over individual DB_* variables.
# For Render PostgreSQL:
# - On Render Web Service: Use the Render "Internal Database URL" (e.g. postgres://user:pass@dpg-xxx:5432/db)
# - For local scripts connecting to Render: Use the Render "External Database URL"
DATABASE_URL=postgres://postgres:1234@localhost:5432/bookleaf_dev

# Fallback discrete connection parameters (used only when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookleaf_dev
DB_USER=postgres
DB_PASSWORD=1234
# DB_SSL=true is automatically enabled when DATABASE_URL contains render.com/neon.tech or in production.
DB_SSL=false

# -----------------------------------------------------------------------------
# 3. AI Provider Configuration
# -----------------------------------------------------------------------------
# Primary provider tried first; fallback providers tried in order on retryable failures.
# Supported values: openai, gemini
AI_PRIMARY_PROVIDER=openai
# Comma-separated fallback providers (e.g. 'gemini' or leave blank to disable fallback)
AI_FALLBACK_PROVIDERS=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=45000

# OpenAI (optional — only needed if using openai as a provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# 4. Authentication — JWT & Cookies
# -----------------------------------------------------------------------------
# REQUIRED: at least 32 characters; use a cryptographically random string in production
JWT_SECRET=bookleaf-dev-jwt-secret-change-in-production-must-be-32-chars
# Token lifetime (ms / s / m / h / d accepted by jsonwebtoken)
JWT_EXPIRES_IN=7d
# Set to true in production HTTPS (enables cross-site SameSite=None; Secure cookie)
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# 5. Initial Admin Account Seeding (Used by npm run db:seed)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@bookleaf.pub
ADMIN_PASSWORD=admin123
ADMIN_NAME=BookLeaf Admin

# -----------------------------------------------------------------------------
# 6. Frontend Configuration (Vercel / Vite)
# -----------------------------------------------------------------------------
# Set this in your Vercel Project Environment Variables to your Render backend URL:
# e.g. VITE_API_URL=https://bookleaf-api.onrender.com
# For local development with Vite proxy, leave as http://localhost:5000 or empty.
VITE_API_URL=http://localhost:5000
